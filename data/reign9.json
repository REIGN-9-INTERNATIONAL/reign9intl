 "news": [
  {
   "id": 1,
   "tanggal": "2025-11-11",
   "gambar": "",
   "judul": {
    "id": "Awal Perjalanan Reign 9 International: Membangun Fondasi Kompetitif dan Komunitas Honor of Kings",
    "en": "The Beginning of Reign 9 International’s Journey: Building a Competitive Foundation and an ‘Honour of Kings’ Community",
    "zh": "Reign 9 International的起步：打造《王者荣耀》的竞技基础与社区"
   },
   "ringkas": {
    "id": "Resmi berdiri pada 11 November 2025, Reign 9 International hadir sebagai rumah bagi pemain kasual maupun kompetitif Honor of Kings yang menjunjung tinggi disiplin, ketangguhan, dan kesetiaan.",
    "en": "Officially established on 11 November 2025, Reign 9 International serves as a home for both casual and competitive Honor of Kings players who uphold the values of discipline, resilience and loyalty.",
    "zh": "Reign 9 International 于 2025 年 11 月 11 日正式成立，致力于为《王者荣耀》的休闲玩家和竞技玩家提供一个家，并始终秉持纪律、坚韧与忠诚的价值观。"
   },
   "isi": {
    "id": "Tanggal 11 November 2025 menjadi tonggak sejarah lahirnya Reign 9 International (R9). Dibangun di atas empat pilar utama—Disiplin, Ketangguhan, Keunggulan, dan Kesetiaan—R9 hadir bukan sekadar sebagai tim, melainkan wadah bertumbuh bagi para pemain Honor of Kings.\n\nKami membuka pintu bagi para pemain yang ingin berkembang bersama melalui Guild in-game resmi kami (Guild ID: 980982 / Tag: R9) serta komunitas Discord Reign 9. Baik pemain kasual yang mencari rekan mabar solid maupun pemain kompetitif yang mengincar panggung turnamen, R9 menyediakan lingkungan yang suportif dan terarah.\n\nMari bergabung bersama keluarga besar Reign 9 International dan ukir sejarah juara bersama kami!",
    "en": "11 November 2025 marked a historic milestone in the founding of Reign 9 International (R9). Built upon four core pillars—Discipline, Resilience, Excellence and Loyalty—R9 exists not merely as a team, but as a platform for growth for Honor of Kings players.\n\nWe are opening our doors to players who wish to grow together through our official in-game guild (Guild ID: 980982 / Tag: R9) and the Reign 9 Discord community. Whether you’re a casual player looking for reliable teammates or a competitive player aiming for the tournament stage, R9 provides a supportive and focused environment.\n\nJoin the Reign 9 International family and help us make history as champions!",
    "zh": "2025年11月11日，成为Reign 9 International（R9）诞生的历史性里程碑。 R9以“纪律、坚韧、卓越、忠诚”四大支柱为基石，不仅是一支战队，更是《王者荣耀》玩家共同成长的沃土。\n\n我们通过官方游戏内公会（公会ID：980982 / 标签：R9）以及Reign 9的Discord社区，向所有希望共同成长的玩家敞开大门。 无论是寻求可靠队友的休闲玩家，还是志在征战赛事舞台的竞技玩家，R9 都将提供一个充满支持且目标明确的环境。\n\n快来加入 Reign 9 International 大家庭，与我们共同谱写冠军传奇吧！"
   }
  }
 ],
 "situs": {
  "teks": {
   "hero.ringkas": {
    "id": "Organisasi esports global yang saat ini berfokus pada game Honor of Kings, dengan jangkauan lintas negara yang mencakup Indonesia, Malaysia, hingga Tiongkok.",
    "en": "A global esports organisation currently focusing on the game *Honour of Kings*, with a cross-border reach spanning Indonesia, Malaysia and China.",
    "zh": "一家目前专注于《王者荣耀》的全球电竞组织，其业务范围横跨印尼、马来西亚乃至中国。"
   },
   "about.sejarah": {
    "id": "Didirikan pada 11 November 2025, REIGN 9 INTERNATIONAL (R9) adalah organisasi esports dengan visi global. Kami berkomitmen untuk mengembangkan potensi pemain, menanamkan disiplin tinggi, dan meraih prestasi di panggung internasional. Dengan lingkungan yang mendukung pemain kasual maupun kompetitif, R9 membangun fondasi yang kuat untuk tumbuh bersama dan mencapai kesuksesan jangka panjang.",
    "en": "Founded on 11 November 2025, REIGN 9 INTERNATIONAL (R9) is an esports organisation with a global vision. We are committed to developing players’ potential, instilling a high level of discipline, and achieving success on the international stage. With an environment that supports both casual and competitive players, R9 is building a strong foundation for growing together and achieving long-term success.",
    "zh": "REIGN 9 INTERNATIONAL（R9）成立于2025年11月11日，是一家具有全球视野的电竞组织。 我们致力于发掘选手的潜力，培养高度的纪律性，并在国际舞台上取得佳绩。R9 营造了一个既支持休闲玩家又支持竞技玩家的环境，以此为共同成长和实现长期成功奠定了坚实的基础。"
   },
